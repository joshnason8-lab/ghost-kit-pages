{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "name": "Background", "color": "#0d1117" },
				{ "slug": "panel", "name": "Panel", "color": "#161c26" },
				{ "slug": "chip", "name": "Chip", "color": "#1f2733" },
				{ "slug": "line", "name": "Line", "color": "#263040" },
				{ "slug": "ink", "name": "Text", "color": "#f2f4f8" },
				{ "slug": "soft", "name": "Soft text", "color": "#c8d0dc" },
				{ "slug": "mute", "name": "Muted text", "color": "#9aa6b8" },
				{ "slug": "accent", "name": "Orange", "color": "#ff8a1f" },
				{ "slug": "accent-2", "name": "Teal", "color": "#2bd4a4" },
				{ "slug": "on-accent", "name": "Text on orange", "color": "#14100a" }
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1280px"
		},
		"spacing": {
			"units": ["px", "em", "rem", "%", "vw"],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "8px" },
				{ "slug": "30", "name": "S", "size": "14px" },
				{ "slug": "40", "name": "M", "size": "24px" },
				{ "slug": "50", "name": "L", "size": "clamp(28px, 4vw, 40px)" },
				{ "slug": "60", "name": "XL", "size": "clamp(40px, 6vw, 64px)" },
				{ "slug": "70", "name": "XXL", "size": "clamp(56px, 8vw, 88px)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "14px", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "16px", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "20px", "fluid": { "min": "17px", "max": "20px" } },
				{ "slug": "x-large", "name": "Extra large", "size": "40px", "fluid": { "min": "30px", "max": "40px" } },
				{ "slug": "xx-large", "name": "Huge", "size": "76px", "fluid": { "min": "40px", "max": "76px" } }
			],
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Inter",
					"fontFamily": "Inter, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/inter-latin-wght-normal.woff2"],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/inter-latin-ext-wght-normal.woff2"],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				},
				{
					"slug": "heading",
					"name": "Oswald",
					"fontFamily": "Oswald, \"Arial Narrow\", Impact, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Oswald",
							"fontStyle": "normal",
							"fontWeight": "200 700",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/oswald-latin-wght-normal.woff2"],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Oswald",
							"fontStyle": "normal",
							"fontWeight": "200 700",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/oswald-latin-ext-wght-normal.woff2"],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				}
			]
		},
		"blocks": {
			"core/image": {
				"lightbox": { "allowEditing": true }
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--ink)"
		},
		"spacing": {
			"blockGap": "24px",
			"padding": {
				"left": "clamp(16px, 4vw, 40px)",
				"right": "clamp(16px, 4vw, 40px)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--accent)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "typography": { "textDecoration": "none" } }
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "700",
					"lineHeight": "1.1"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "lineHeight": "1.02" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "20px", "fontFamily": "var(--wp--preset--font-family--body)", "fontWeight": "600", "lineHeight": "1.3" } },
			"h4": { "typography": { "fontSize": "17px", "fontFamily": "var(--wp--preset--font-family--body)", "fontWeight": "600" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--on-accent)"
				},
				"border": { "radius": "12px" },
				"spacing": { "padding": { "top": "13px", "bottom": "13px", "left": "22px", "right": "22px" } },
				"typography": { "fontWeight": "600", "fontSize": "16px", "lineHeight": "1.2", "textDecoration": "none" },
				":hover": { "color": { "background": "#ffa04a", "text": "var(--wp--preset--color--on-accent)" } },
				":focus": { "color": { "background": "#ffa04a", "text": "var(--wp--preset--color--on-accent)" } }
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--mute)" },
				"typography": { "fontSize": "13px" }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "700",
					"fontSize": "24px",
					"textTransform": "uppercase",
					"letterSpacing": "0.5px",
					"lineHeight": "1"
				},
				"elements": { "link": { "color": { "text": "var(--wp--preset--color--ink)" }, "typography": { "textDecoration": "none" } } }
			},
			"core/navigation": {
				"typography": { "fontWeight": "500", "fontSize": "16px" },
				"elements": { "link": { "typography": { "textDecoration": "none" } } }
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--line)" }
			},
			"core/table": {
				"typography": { "fontSize": "15px" }
			}
		}
	},
	"customTemplates": [
		{ "name": "page-wide", "title": "Wide page (content sets its own heading)", "postTypes": ["page"] }
	],
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
