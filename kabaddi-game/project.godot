; Engine configuration file.
; Godot 4.7. Open this folder in the Godot editor, or run tools/ci scripts headless.

config_version=5

[application]

config/name="Kabaddi Raid"
config/version="0.4.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.047, 0.102, 0.161, 1)
boot_splash/show_image=false

[autoload]

Game="*res://autoload/game.gd"
DB="*res://autoload/db.gd"
Sfx="*res://autoload/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations=PackedStringArray("res://i18n/strings.en.translation", "res://i18n/strings.hi.translation", "res://i18n/strings.mr.translation", "res://i18n/strings.ta.translation", "res://i18n/strings.te.translation", "res://i18n/strings.kn.translation", "res://i18n/strings.bn.translation", "res://i18n/strings.pa.translation")
locale/fallback="en"

[rendering]

environment/defaults/default_clear_color=Color(0.047, 0.102, 0.161, 1)

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
