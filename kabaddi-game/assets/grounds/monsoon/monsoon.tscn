shader_parameter/turn = -0.023
shader_parameter/energy = 1.2
shader_parameter/light_energy = 0.31
shader_parameter/hdr_energy = 0.15
shader_parameter/light_max = 6.0
shader_parameter/saturation = 0.35
shader_parameter/ground = Color(0.16, 0.14, 0.12, 1)
