; World Stage Games shared foundation: the addon (addons/wsg_foundation), its tools and its tests.
; Godot 4.7. Tests: see README.md.

config_version=5

[application]

config/name="WSG Foundation"
config/features=PackedStringArray("4.7", "GL Compatibility")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
